# Copie este arquivo para .env e preencha DB_* e JWT_SECRET com os seus valores.
# O .env real NÃO vai para o Git (está no .gitignore).
PORT=3000
CORS_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fittrack
DB_USER=root
DB_PASSWORD=
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRES_IN=1d
